#include "driver/i2s.h"
#include "BluetoothSerial.h"

BluetoothSerial SerialBT;

// I2S Speaker Pins
#define I2S_BCLK 26
#define I2S_LRC  25
#define I2S_DOUT 22

#define CHUNK 128

int16_t buffer[CHUNK];

void setup() {
  Serial.begin(115200);

  SerialBT.begin("ESP32_SPK");

  Serial.println("Bluetooth Speaker Ready...");

  i2s_config_t config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = 8000,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_I2S,
    .intr_alloc_flags = 0,
    .dma_buf_count = 6,
    .dma_buf_len = 64,
    .use_apll = false,
    .tx_desc_auto_clear = true,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRC,
    .data_out_num = I2S_DOUT,
    .data_in_num = I2S_PIN_NO_CHANGE
  };

  i2s_driver_install(I2S_NUM_0, &config, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin_config);

  Serial.println("Ready to play audio...");
}

void loop() {
  if (SerialBT.available()) {

    int len = SerialBT.readBytes((uint8_t*)buffer, sizeof(buffer));

    if (len > 0) {
      size_t written;
      i2s_write(I2S_NUM_0, buffer, len, &written, portMAX_DELAY);
    }
  }
}
